{
  "name": "analytics-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic analytics connectors and UI widgets for any website dashboard.",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "build:site": "pnpm build && pnpm registry:build && next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "pnpm -r --filter=./packages/* exec publint",
    "attw": "pnpm -r --filter=./packages/* --filter=!@analytics-kit/react exec attw --pack . && pnpm --filter @analytics-kit/react exec attw --pack . --exclude-entrypoints styles.css",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm typecheck && pnpm publint && pnpm attw",
    "dev": "next dev",
    "start": "next start",
    "clean": "pnpm -r exec rm -rf dist",
    "registry:build": "node scripts/build-registry.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "smoke": "node scripts/smoke.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "homepage": "https://analytics-kit-demo.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educlopez/analytics-kit.git"
  },
  "license": "MIT",
  "dependencies": {
    "@analytics-kit/connector-mock": "workspace:*",
    "@analytics-kit/connector-vercel": "workspace:*",
    "@analytics-kit/core": "workspace:*",
    "@analytics-kit/next": "workspace:*",
    "@analytics-kit/react": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dialkit": "^1.4.3",
    "merge-refs": "^2.0.0",
    "motion": "^13.2.0",
    "next": "^16.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "publint": "^0.3.12",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "world-countries": "^5.1.0"
  }
}
