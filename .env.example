# Source project for the live dashboard: analytics-kit-demo itself (Vercel team Ignia).
# Set these explicitly — Vercel's auto-injected VERCEL_PROJECT_ID is not read by the connector.
# Requires Web Analytics enabled on the project and a token scoped to the owning team.
ANALYTICS_VERCEL_TOKEN=
ANALYTICS_VERCEL_PROJECT_ID=
ANALYTICS_VERCEL_TEAM_ID=

# Production origin for the shadcn registry JSON (no trailing slash).
# Vercel production: https://wingtics.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
