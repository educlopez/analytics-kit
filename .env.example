# Token with Web Analytics read access. On Vercel, VERCEL_PROJECT_ID and
# VERCEL_ORG_ID are injected automatically — only the token is required there.
ANALYTICS_VERCEL_TOKEN=
# Optional overrides if you are not deploying on Vercel:
# ANALYTICS_VERCEL_PROJECT_ID=
# ANALYTICS_VERCEL_TEAM_ID=

# Production origin for the shadcn registry JSON (no trailing slash).
# Vercel production: https://analytics-kit-demo.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
