{
  "name": "@analytics-kit/connector-umami",
  "version": "0.2.0",
  "description": "Umami Analytics connector for Analytics Kit.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@analytics-kit/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "author": "Edu Calvo <educlopez93@gmail.com>",
  "homepage": "https://github.com/educlopez/analytics-kit/tree/main/packages/connector-umami",
  "bugs": {
    "url": "https://github.com/educlopez/analytics-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educlopez/analytics-kit.git",
    "directory": "packages/connector-umami"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "analytics",
    "dashboard",
    "plausible",
    "ga4",
    "vercel",
    "umami",
    "posthog"
  ],
  "sideEffects": false
}
