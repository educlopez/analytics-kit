{
  "name": "@analytics-kit/next",
  "version": "0.1.0",
  "description": "Next.js / Fetch handlers that proxy Analytics Kit connectors without exposing API keys.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@analytics-kit/core": "workspace:*"
  },
  "devDependencies": {
    "@analytics-kit/connector-mock": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
