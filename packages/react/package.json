{
  "name": "@analytics-kit/react",
  "version": "0.6.0",
  "description": "Provider-agnostic analytics widgets and dashboard primitives for React.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@analytics-kit/core": "workspace:*",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "d3-scale": "^4.0.2",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "author": "Edu Calvo <educlopez93@gmail.com>",
  "homepage": "https://github.com/educlopez/analytics-kit/tree/main/packages/react",
  "bugs": {
    "url": "https://github.com/educlopez/analytics-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/educlopez/analytics-kit.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "analytics",
    "dashboard",
    "plausible",
    "ga4",
    "vercel",
    "umami",
    "posthog",
    "react"
  ],
  "sideEffects": true
}
