{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "analytics-kit",
  "homepage": "https://analytics-kit-demo.vercel.app/",
  "items": [
    {
      "name": "chart",
      "type": "registry:ui",
      "title": "Chart",
      "description": "Recharts container used by every Analytics Kit chart. Colors inherit --chart-1…5 from the host theme.",
      "dependencies": ["recharts@2.15.4", "clsx", "tailwind-merge"],
      "files": [
        {
          "path": "packages/react/src/lib/cn.ts",
          "type": "registry:lib",
          "target": "@lib/cn.ts"
        },
        {
          "path": "packages/react/src/charts/chart.tsx",
          "type": "registry:ui",
          "target": "@ui/chart.tsx"
        },
        {
          "path": "packages/react/src/charts/variants.ts",
          "type": "registry:lib",
          "target": "@lib/chart-variants.ts"
        }
      ],
      "docs": "Map --chart-1…--chart-5 in your CSS. Charts do not ship a color theme.",
      "categories": ["analytics", "charts"]
    },
    {
      "name": "area-chart",
      "type": "registry:ui",
      "title": "Area chart",
      "description": "Trend with filled region. Variants: gradient, linear, natural, step, dots, spark.",
      "dependencies": ["recharts@2.15.4"],
      "registryDependencies": ["https://analytics-kit-demo.vercel.app/r/chart.json"],
      "files": [
        {
          "path": "packages/react/src/charts/area-chart.tsx",
          "type": "registry:ui",
          "target": "@ui/area-chart.tsx"
        }
      ],
      "categories": ["analytics", "charts"]
    },
    {
      "name": "line-chart",
      "type": "registry:ui",
      "title": "Line chart",
      "description": "Time series line. Variants: monotone, linear, step, dashed, dots.",
      "dependencies": ["recharts@2.15.4"],
      "registryDependencies": ["https://analytics-kit-demo.vercel.app/r/chart.json"],
      "files": [
        {
          "path": "packages/react/src/charts/line-chart.tsx",
          "type": "registry:ui",
          "target": "@ui/line-chart.tsx"
        }
      ],
      "categories": ["analytics", "charts"]
    },
    {
      "name": "bar-chart",
      "type": "registry:ui",
      "title": "Bar chart",
      "description": "Category comparison. Variants: vertical, horizontal, rounded, hatched.",
      "dependencies": ["recharts@2.15.4"],
      "registryDependencies": ["https://analytics-kit-demo.vercel.app/r/chart.json"],
      "files": [
        {
          "path": "packages/react/src/charts/bar-chart.tsx",
          "type": "registry:ui",
          "target": "@ui/bar-chart.tsx"
        }
      ],
      "categories": ["analytics", "charts"]
    },
    {
      "name": "pie-chart",
      "type": "registry:ui",
      "title": "Pie chart",
      "description": "Share of a whole. Variants: donut, pie, legend.",
      "dependencies": ["recharts@2.15.4"],
      "registryDependencies": ["https://analytics-kit-demo.vercel.app/r/chart.json"],
      "files": [
        {
          "path": "packages/react/src/charts/pie-chart.tsx",
          "type": "registry:ui",
          "target": "@ui/pie-chart.tsx"
        }
      ],
      "categories": ["analytics", "charts"]
    },
    {
      "name": "metric-card",
      "type": "registry:block",
      "title": "Metric card",
      "description": "KPI card wired to Analytics Kit. Variants: default, spark, compact, hero.",
      "dependencies": ["@analytics-kit/react"],
      "files": [
        {
          "path": "registry/default/blocks/metric-card.tsx",
          "type": "registry:component",
          "target": "@components/analytics/metric-card.tsx"
        }
      ],
      "categories": ["analytics"]
    },
    {
      "name": "dashboard",
      "type": "registry:block",
      "title": "Analytics dashboard",
      "description": "Widget catalog on a 4-column grid, fed by a connector.",
      "dependencies": ["@analytics-kit/react"],
      "files": [
        {
          "path": "registry/default/blocks/dashboard.tsx",
          "type": "registry:component",
          "target": "@components/analytics/dashboard.tsx"
        }
      ],
      "docs": "pnpm add @analytics-kit/react @analytics-kit/core recharts\nimport \"@analytics-kit/react/styles.css\";",
      "categories": ["analytics", "dashboard"]
    }
  ]
}
